# SQLite database and WAL files are local state.
# Issues live on the bd server; a release commits `bd export -o .bd/issues.jsonl` for its notes.
bd.db
bd.db-wal
bd.db-shm
# What `bd agents pull` placed in this checkout is local state.
agents.lock*
# What `bd publish` keeps next to a local workspace is local state.
/publish.lock
/publish.prev/
/.publish-*/
