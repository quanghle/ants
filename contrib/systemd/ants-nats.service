# ants: the machine's nats-server, its leaf node (`ants leaf config`) or, on the hub machine, the hub.
# User unit: scripts/install-units.sh fills in the @...@ placeholders and installs it in ~/.config/systemd/user.
# Reload a new uplink: systemctl --user reload ants-nats
# Renewed uplink credentials need a restart (ants add does it itself): systemctl --user restart ants-nats
# On the hub, the configuration needs `feature_flags { js_api_reply_v2: true }` for leaf outboxes (docs/transport.md, "Hub").
# Restart=always starts nats-server again after any exit, also a clean one on a SIGTERM systemd did not send; only
# systemctl --user stop ants-nats keeps it stopped.

[Unit]
Description=ants: local nats-server (leaf node or hub)
# Starts after the tunnel or bridge its uplink goes through, if installed; the leaf retries the uplink until it is up.
After=ants-devtunnel.service ants-bridge.service

[Service]
ExecStart="@NATS_SERVER@" -c "@NATS_CONF@"
ExecReload=kill -HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
