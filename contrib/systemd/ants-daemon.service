# ants: the ant daemon (antsd), serving the ants of its config file through the local nats-server.
# User unit: scripts/install-units.sh fills in the @...@ placeholders and installs it in ~/.config/systemd/user.
# Until ants-nats listens, the daemon waits, retrying the connection; Restart covers other failures.
# Serve the ants of an edited config file without a restart (ants add does it itself): systemctl --user reload ants-daemon

[Unit]
Description=ants: ant daemon
Wants=ants-nats.service
After=ants-nats.service

[Service]
ExecStart="@ANTS@" daemon --config "@CONFIG@"
ExecReload=kill -HUP $MAINPID
# The harness (copilot) and bd are looked up on this PATH.
Environment="PATH=@PATH@" NO_COLOR=1
Restart=on-failure
RestartSec=10
# A replaced ants executable (an upgrade) exits with status 75, restarting onto the new one.
SuccessExitStatus=75
RestartForceExitStatus=75
# SIGTERM lets prompts in flight finish; messages cut off by the timeout are redelivered.
TimeoutStopSec=120

[Install]
WantedBy=default.target
