# ants: the ant daemon (ants daemon), serving the ants of its config file through the local nats-server: the
# ants-nats unit's, or, with [nats_server] in the config file (install-units.sh --managed-nats, no ants-nats unit), one
# the daemon starts and stops itself.
# User unit: scripts/install-units.sh fills in the @...@ placeholders and installs it in ~/.config/systemd/user.
# Until ants-nats listens, the daemon waits, retrying the connection. Without the ants-nats unit, Wants and After name
# nothing. Restart=always starts the daemon again after any exit, also a clean one on a SIGTERM systemd did not
# send; only systemctl --user stop ants-daemon keeps it stopped.
# The daemon reloads an edited config file within seconds; to reload at once: systemctl --user reload ants-daemon

[Unit]
Description=ants: ant daemon
Wants=ants-nats.service
After=ants-nats.service

[Service]
ExecStart="@ANTS@" daemon --config "@CONFIG@"
ExecReload=kill -HUP $MAINPID
# The harness command (such as copilot or claude-agent-acp) and bd are looked up on this PATH.
Environment="PATH=@PATH@" NO_COLOR=1
# Open files: about 4 per ant and 3 per live harness; systemd's default soft limit of 1024 runs out near 250 ants. The
# daemon raises its soft limit to the hard one at start in any case.
LimitNOFILE=65536
Restart=always
RestartSec=10
# A replaced ants executable (an upgrade) exits with status 75, restarting onto the new one.
SuccessExitStatus=75
RestartForceExitStatus=75
# SIGTERM lets prompts in flight finish; messages cut off by the timeout are redelivered.
TimeoutStopSec=120
# SIGTERM to the daemon alone: it drains, then stops its harnesses and its nats-server. Whatever is left in the unit
# at the timeout or once the daemon exits gets SIGKILL.
KillMode=mixed

[Install]
WantedBy=default.target
