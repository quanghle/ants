<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ants: the signer (`ants signer`), signing the credentials of the ants manager ants ask for: at once within the
     policy of the [[ant_template]] tables of its config file, on a human's approval otherwise. Run it on the machine
     holding the auth directory (~/.config/ants/auth), whose account key it signs with.
     scripts/install-units.sh --signer fills in the @...@ placeholders and installs it as
     ~/Library/LaunchAgents/ants.signer.plist. Until the hub answers, the signer fails, and KeepAlive and
     ThrottleInterval start it again.
     A replaced ants executable (an upgrade) exits with status 75, which KeepAlive restarts onto the new one. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ants.signer</string>
	<key>ProgramArguments</key>
	<array>
		<string>@ANTS@</string>
		<string>signer</string>
		<string>--config</string>
		<string>@CONFIG@</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NO_COLOR</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>@LOGS@/signer.log</string>
	<key>StandardErrorPath</key>
	<string>@LOGS@/signer.log</string>
</dict>
</plist>
