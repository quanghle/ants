<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ants: the ant daemon (ants daemon), serving the ants of its config file through the local nats-server: the
     ants.nats agent's, or, with [nats_server] in the config file and no ants.nats agent, one the daemon starts and
     stops itself.
     scripts/install-units.sh fills in the @...@ placeholders and installs it as ~/Library/LaunchAgents/ants.daemon.plist.
     launchd has no start order: until ants.nats listens, the daemon waits, retrying the connection. KeepAlive and
     ThrottleInterval cover other failures.
     SIGTERM lets prompts in flight finish for up to ExitTimeOut seconds; messages cut off are redelivered. Then the
     daemon stops its harnesses and its nats-server.
     The daemon reloads an edited config file within seconds; to reload at once: launchctl kill SIGHUP gui/$(id -u)/ants.daemon
     A replaced ants executable (an upgrade) exits with status 75, which KeepAlive restarts onto the new one. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ants.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>@ANTS@</string>
		<string>daemon</string>
		<string>--config</string>
		<string>@CONFIG@</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- The harness command (such as copilot or claude-agent-acp) and bd are looked up on this PATH. -->
		<key>PATH</key>
		<string>@PATH@</string>
		<key>NO_COLOR</key>
		<string>1</string>
	</dict>
	<!-- Open files: about 4 per ant and 3 per live harness. launchd's soft limit of 256 runs out near 50 ants; the
	     daemon raises its soft limit to the hard one (at most kern.maxfilesperproc) at start in any case. -->
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>10240</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>120</integer>
	<key>StandardOutPath</key>
	<string>@LOGS@/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>@LOGS@/daemon.log</string>
</dict>
</plist>
