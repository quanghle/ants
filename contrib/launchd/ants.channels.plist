<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ants: the channel manager (`ants channel serve`), applying the channel changes owner ants ask for. Run it on one
     machine where no ant runs, such as the hub, with the credentials of `ants auth channel-manager`.
     scripts/install-units.sh --channel-manager CREDS fills in the @...@ placeholders and installs it as
     ~/Library/LaunchAgents/ants.channels.plist. Until the hub answers, the channel manager waits, retrying the
     connection; KeepAlive and ThrottleInterval cover other failures, such as a missing channels bucket before
     `ants init`.
     A replaced ants executable (an upgrade) exits with status 75, which KeepAlive restarts onto the new one. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ants.channels</string>
	<key>ProgramArguments</key>
	<array>
		<string>@ANTS@</string>
		<string>channel</string>
		<string>serve</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ANTS_CREDS</key>
		<string>@CHANNEL_CREDS@</string>
		<key>NO_COLOR</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>@LOGS@/channels.log</string>
	<key>StandardErrorPath</key>
	<string>@LOGS@/channels.log</string>
</dict>
</plist>
